{
  "name": "fluttergeti18ngenerator",
  "displayName": "fluttergeti18ngenerator",
  "description": "Generate app_i18n.dart from app_i18n.csv for Flutter GetX projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/LunaGao/Vscode-Extension-Flutter-Get-I18N-Generator.git"
  },
  "homepage": "https://github.com/LunaGao/Vscode-Extension-Flutter-Get-I18N-Generator",
  "bugs": {
    "url": "https://github.com/LunaGao/Vscode-Extension-Flutter-Get-I18N-Generator/issues"
  },
  "publisher": "LunaGao",
  "version": "0.1.5",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:csv"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fluttergeti18ngenerator.enableordisablefluttergeti18ngenerator",
        "title": "Flutter Enable/Disable app_i18n.csv Generator"
      },
      {
        "command": "fluttergeti18ngenerator.enableordisablefluttergeti18ngeneratoriosi18n",
        "title": "Flutter i18n generate iOS i18n"
      }
    ],
    "configuration": {
      "title": "Flutter Get I18N Generator",
      "properties": {
        "conf.flutter.i18ncsv.enable": {
          "type": "boolean",
          "default": false,
          "description": "Enable or Disable auto generate the app_i18n.dart file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.0",
    "glob": "^7.2.3",
    "mocha": "^10.8.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "csv": "6.4.1"
  },
  "pricing": "Free"
}
